#!/bin/bash
# wf-run — build a Linear ticket, one full /wf session per repo it touches.
# wf-run-ac does the same, then proves the acceptance criteria with evidence on the ticket.
#
# A Claude Code session loads one repo's CLAUDE.md, project agents, hooks and skills: the
# ones where it starts. So each repo's part of a ticket is built by its own headless session,
# started in that repo's checkout:
#   1. `/wf --split-only <ticket>` splits the ticket into one [repo] sub-issue per repo
#      (or reuses the sub-issues an earlier run made) and prints each with what it needs.
#   2. Units are built in waves: every unit whose needs are finished starts at once, each as
#      `/wf <sub-issue>` in its repo's checkout (from ~/.claude/wf-repos.json). A unit that
#      needs another repo's change waits for that PR, then builds against it through Linear.
# The run stops after a wave in which a unit didn't finish. Re-running resumes: /wf skips
# sub-issues whose PR is already open, and reuses worktrees for the rest.
#
# Usage:  wf-run <ticket-id>
# Env:    WF_PERMISSION_MODE   permission mode for each headless session (default: auto)
#         CLAUDE_HOME          Claude config dir (default: ~/.claude)
#         WF_LOG_DIR           where logs and results.tsv go (default: ~/.claude/wf-logs/<ticket>/<time>)
# Output: results.tsv in the log dir: one "<id>\t<repo>\t<state>\t<pr>" line per unit.
#         `wf-run-ac` reads it to prove the acceptance criteria after the build.
# Exit:   0 every sub-issue finished · 1 usage/setup error · 2 a sub-issue didn't finish
#         3 the ticket needs a repo that isn't in wf-repos.json
set -uo pipefail

TICKET="${1:-}"
if [ -z "$TICKET" ] || [ "$#" -ne 1 ]; then
  echo "usage: wf-run <ticket-id>" >&2
  exit 1
fi

CLAUDE_DIR="${CLAUDE_HOME:-$HOME/.claude}"
MAP="$CLAUDE_DIR/wf-repos.json"
MODE="${WF_PERMISSION_MODE:-auto}"
LOG_DIR="${WF_LOG_DIR:-$CLAUDE_DIR/wf-logs/$TICKET/$(date +%Y%m%d-%H%M%S)}"

say() { printf '%s %s\n' "$(date +%H:%M)" "$*"; }
die() { say "ERROR: $1" >&2; exit "${2:-1}"; }

for dep in claude jq git; do
  command -v "$dep" >/dev/null 2>&1 || die "missing dependency: $dep"
done
[ -f "$MAP" ] || die "no repo map at $MAP (copy wf-repos.example.json there and set your checkout paths)"
mkdir -p "$LOG_DIR" || die "can't create $LOG_DIR"

# Run one headless session in <dir> and print its final text. Full JSON goes to <log>.json.
run_session() {
  local dir="$1" prompt="$2" log="$3"
  # </dev/null: `claude -p` appends stdin to the prompt, and inside the build loop stdin is
  # the list of units, so without it the first session swallows every later unit.
  (cd "$dir" && claude -p "$prompt" --permission-mode "$MODE" --output-format json) \
    </dev/null >"$log.json" 2>"$log.err"
  local rc=$?
  if [ "$rc" -ne 0 ] || [ "$(jq -r '.is_error // false' "$log.json" 2>/dev/null)" = "true" ]; then
    say "session failed in $dir (exit $rc); see $log.json and $log.err" >&2
    return 1
  fi
  jq -r '.result // empty' "$log.json" | tee "$log.txt"
}

# A checkout Claude Code hasn't been trusted in loads none of its own settings, hooks or
# allow rules in a headless session, which is the whole point of one session per repo.
CLAUDE_JSON="${CLAUDE_CONFIG_JSON:-$HOME/.claude.json}"
is_trusted() {
  [ -f "$CLAUDE_JSON" ] || return 0   # can't tell; don't block
  [ "$(jq -r --arg p "$1" '.projects[$p].hasTrustDialogAccepted // false' "$CLAUDE_JSON" 2>/dev/null)" = "true" ]
}
require_trusted() {
  local bad=""
  for dir in "$@"; do is_trusted "$dir" || bad="$bad $dir"; done
  [ -z "$bad" ] && return 0
  say "ERROR: Claude Code hasn't been trusted in:" >&2
  for dir in $bad; do printf '  %s\n' "$dir" >&2; done
  printf '%s\n' "A headless session there ignores the repo's own settings, hooks and allow rules." \
    "Run 'claude' once in each, accept the trust prompt, exit, then re-run." >&2
  exit 1
}

# The split can run from any listed checkout: it only reads the checkouts and talks to Linear.
# Prefer a trusted one; fall back to the first that exists (and stop if it isn't trusted).
SPLIT_DIR="$(jq -r '.repos[].path' "$MAP" | while read -r p; do { [ -d "$p/.git" ] || [ -f "$p/.git" ]; } && is_trusted "$p" && { echo "$p"; break; }; done)"
[ -n "$SPLIT_DIR" ] || SPLIT_DIR="$(jq -r '.repos[].path' "$MAP" | while read -r p; do [ -d "$p/.git" ] || [ -f "$p/.git" ] && { echo "$p"; break; }; done)"
[ -n "$SPLIT_DIR" ] || die "no checkout in $MAP exists on this machine"
require_trusted "$SPLIT_DIR"

say "$TICKET: splitting by repo (logs: $LOG_DIR)"
SPLIT_OUT="$(run_session "$SPLIT_DIR" "/wf --split-only $TICKET" "$LOG_DIR/split")" || die "split session failed"
UNITS="$(printf '%s\n' "$SPLIT_OUT" | awk '$1 == "UNIT" { print $2, $3, $4, ($5 == "" ? "-" : $5) }')"
[ -n "$UNITS" ] || die "split printed no UNIT lines; see $LOG_DIR/split.txt"

if printf '%s\n' "$UNITS" | awk '$3 == "missing" { found = 1 } END { exit !found }'; then
  printf '%s\n' "$UNITS" | awk '$3 == "missing" { print "  needs a checkout of " $2 " (" $1 ")" }' >&2
  die "add the missing repos to $MAP, then re-run" 3
fi

say "$TICKET: units:"
printf '%s\n' "$UNITS" | awk '{ printf "  %s [%s] in %s%s\n", $1, $2, $3, ($4 == "-" ? "" : " (after " $4 ")") }'
# shellcheck disable=SC2046
require_trusted $(printf '%s\n' "$UNITS" | awk 'NF { print $3 }' | sort -u)

# Build one unit; its result ("<state> <pr>") goes to <id>.result so waves can run in parallel.
build_unit() {
  local id="$1" repo="$2" dir="$3" out result
  say "$id [$repo]: building in $dir"
  if ! out="$(run_session "$dir" "/wf $id" "$LOG_DIR/$id")"; then
    echo "error" >"$LOG_DIR/$id.result"
    return
  fi
  result="$(printf '%s\n' "$out" | awk -v id="$id" '$1 == "WF_RESULT" && $2 == id { print $3, $4 }' | tail -1)"
  echo "${result:-noresult}" >"$LOG_DIR/$id.result"
}

ALL_IDS=" $(printf '%s\n' "$UNITS" | awk 'NF { print $1 }' | tr '\n' ' ')"
TOTAL="$(printf '%s\n' "$UNITS" | awk 'NF' | wc -l | tr -d ' ')"
DONE=" "
BUILT=0
STATUS=0
PENDING="$UNITS"

while [ -n "$PENDING" ] && [ "$STATUS" -eq 0 ]; do
  # A unit is ready when everything it needs is done. A need outside this run's units is
  # already finished (the split leaves out finished sub-issues).
  WAVE=""
  REST=""
  while read -r ID REPO DIR NEEDS; do
    [ -n "$ID" ] || continue
    READY=1
    if [ "$NEEDS" != "-" ]; then
      for N in ${NEEDS//,/ }; do
        case "$ALL_IDS" in *" $N "*) case "$DONE" in *" $N "*) ;; *) READY=0 ;; esac ;; esac
      done
    fi
    if [ "$READY" -eq 1 ]; then WAVE="$WAVE$ID $REPO $DIR"$'\n'; else REST="$REST$ID $REPO $DIR $NEEDS"$'\n'; fi
  done <<<"$PENDING"

  if [ -z "$WAVE" ]; then
    say "$TICKET: the remaining units need each other; check their blocked-by links"
    STATUS=2
    break
  fi

  while read -r ID REPO DIR; do
    [ -n "$ID" ] && build_unit "$ID" "$REPO" "$DIR" &
  done <<<"$WAVE"
  wait

  while read -r ID REPO DIR; do
    [ -n "$ID" ] || continue
    RESULT="$(cat "$LOG_DIR/$ID.result" 2>/dev/null)"
    STATE="${RESULT%% *}"
    PR=""
    [ "$RESULT" != "$STATE" ] && PR="${RESULT#* }"
    printf '%s\t%s\t%s\t%s\n' "$ID" "$REPO" "${STATE:-error}" "${PR:-none}" >>"$LOG_DIR/results.tsv"
    case "$STATE" in
      finished|skipped)
        say "$ID [$REPO]: $STATE, ${PR:-no PR}"; DONE="$DONE$ID "; BUILT=$((BUILT + 1)) ;;
      error)
        say "$ID [$REPO]: session failed; see $LOG_DIR/$ID.json"; STATUS=2 ;;
      noresult|"")
        say "$ID [$REPO]: no WF_RESULT line; see $LOG_DIR/$ID.txt"; STATUS=2 ;;
      *)
        say "$ID [$REPO]: $STATE, ${PR:-no PR}"; STATUS=2 ;;
    esac
  done <<<"$WAVE"
  PENDING="$REST"
done

if [ "$STATUS" -eq 0 ] && [ "$BUILT" -ne "$TOTAL" ]; then
  say "$TICKET: only $BUILT of $TOTAL sub-issues ran; stopping"; STATUS=2
fi
if [ "$STATUS" -ne 0 ] && [ -n "$PENDING" ]; then
  say "$TICKET: not started:"
  printf '%s' "$PENDING" | awk 'NF { print "  " $1 " [" $2 "]" ($4 == "-" ? "" : " (needs " $4 ")") }'
fi
[ "$STATUS" -eq 0 ] && say "$TICKET: every repo finished. Review and merge happen on GitHub."
say "$TICKET: logs in $LOG_DIR"
exit "$STATUS"
