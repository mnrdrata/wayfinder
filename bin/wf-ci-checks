#!/bin/bash
# wf-ci-checks — watch a PR's CI checks until they settle (at most ~9 min), then report.
# Read-only. One plain command so a single permission rule covers it (no inline loops).
# Usage: wf-ci-checks <worktree> <pr-number>
set -uo pipefail
WT="${1:?usage: wf-ci-checks <worktree> <pr-number>}"
PR="${2:?usage: wf-ci-checks <worktree> <pr-number>}"
cd "$WT" || { echo "ERROR: no such worktree: $WT"; exit 1; }

j='[]'
for i in $(seq 1 26); do
  j=$(gh pr checks "$PR" --json name,bucket,link,workflow 2>/dev/null) || true
  [ -z "$j" ] && j='[]'
  n=$(jq 'length' <<<"$j")
  p=$(jq '[.[] | select(.bucket=="pending")] | length' <<<"$j")
  [ "$n" -gt 0 ] && [ "$p" -eq 0 ] && break
  # Checks take ~30-60 s to register after a push: "none" only after a few empty polls.
  [ "$n" -eq 0 ] && [ "$i" -ge 4 ] && break
  sleep 20
done

n=$(jq 'length' <<<"$j")
p=$(jq '[.[] | select(.bucket=="pending")] | length' <<<"$j")
f=$(jq '[.[] | select(.bucket=="fail" or .bucket=="cancel")] | length' <<<"$j")
if   [ "$n" -eq 0 ]; then echo "CHECKS: NONE"; exit 0
elif [ "$p" -gt 0 ]; then echo "CHECKS: PENDING"; exit 0
elif [ "$f" -eq 0 ]; then echo "CHECKS: PASS"; exit 0
fi

echo "CHECKS: FAIL"
echo "FAILED:"
jq -r '.[] | select(.bucket=="fail" or .bucket=="cancel") | [.name, (.workflow // ""), (.link // "")] | @tsv' <<<"$j" |
while IFS=$'\t' read -r name workflow link; do
  echo "- $name ($workflow) — $link"
  echo "  LOG:"
  if [[ "$link" =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
    # Drop the "<job>\t<step>\t<timestamp> " prefix on every line; keep the last 100 lines.
    gh run view "${BASH_REMATCH[1]}" --job "${BASH_REMATCH[2]}" --log-failed 2>&1 |
      sed -E -e $'s/^[^\t]*\t[^\t]*\t\xef\xbb\xbf?[0-9T:.-]+Z //' -e $'s/^[^\t]*\t[^\t]*\t//' |
      grep -v '^[[:space:]]*$' | tail -n 100 | sed 's/^/  /'
  else
    echo "  not a GitHub Actions check — see the link"
  fi
done
